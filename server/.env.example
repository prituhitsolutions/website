PORT=5000
# Local example: postgres://postgres:password@localhost:5432/prituhit
DATABASE_URL=postgres://postgres:password@localhost:5432/prituhit
# Set true for hosted Postgres that requires SSL (Neon, Render, Supabase...)
DATABASE_SSL=false
CLIENT_ORIGIN=http://localhost:5173
# Key needed to read enquiries: send as header "x-admin-key"
ADMIN_KEY=change-me-to-a-long-random-string
